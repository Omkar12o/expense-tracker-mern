# Copy to .env.local for local development. Never commit real secrets.
# Vite exposes every VITE_* value to the browser, so only put public URLs here.
# The client normalises the value and appends /api when it is missing.
# In production this is optional: /api is proxied to the backend by vercel.json.
VITE_API_URL=http://localhost:4000/api
# Production example (recommended when you want direct cross-origin API calls):
# VITE_API_URL=https://expense-tracker-mern-qgx7.vercel.app/api
VITE_CURRENCY=$
