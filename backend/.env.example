# Copy to .env and replace placeholders. Never commit .env.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker

# Use a random string of at least 32 characters in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins. No trailing slash.
CLIENT_URL=http://localhost:5173

BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1000
CURRENCY_SYMBOL=$

# Shared with Vercel cron jobs. Use a separate random value in production.
CRON_SECRET=replace-with-a-random-cron-secret-at-least-16-characters
