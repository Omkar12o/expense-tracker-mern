# Copy to .env for local development. Never commit .env or real secrets.
# On Vercel, set these values in the backend project's Environment Variables;
# Vercel does not read this file.
NODE_ENV=development
PORT=4000

# Local MongoDB for development; use an Atlas SRV URI in production. Required.
# Production rejects localhost and placeholder values such as YOUR_PASSWORD.
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker

# Required everywhere. Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins. No trailing slash.
# Production example: CLIENT_URL=https://expense-tracker-mern-neon.vercel.app
CLIENT_URL=http://localhost:5173

BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1000
CURRENCY_SYMBOL=$

# Required everywhere. Use at least 32 random characters in production.
# Vercel sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-random-cron-secret-at-least-32-characters
